include .gitignore 项目文档/LICENSE 项目文档/README.md 项目文档/ORIGIN.md 项目文档/DEFENSIVE_SCOPE.md 项目文档/VALIDATION.md SOURCE_REVIEW_MANIFEST.json
recursive-include licenses *.txt
recursive-include tests *.py
recursive-include .github *.yml
recursive-include evidence *.json

# Current formal source inventory, including provenance and tests.
include .github/workflows/ci.yml
include .gitignore
include 项目文档/DEFENSIVE_SCOPE.md
include 项目文档/LICENSE
include 项目文档/ORIGIN.md
include 项目文档/README.md
include SOURCE_REVIEW_MANIFEST.json
include 项目文档/VALIDATION.md
include evidence/source-review.json
include evidence/upstream-review.json
include evidence/validation.json
include pyproject.toml
include src/wheel_namespace_review/__init__.py
include src/wheel_namespace_review/__main__.py
include src/wheel_namespace_review/cli.py
include src/wheel_namespace_review/review.py
include tests/test_reader_capabilities.py
include tests/test_review.py

# Directory layout: canonical docs and source build entry; generated trees are not sdist inputs.
graft 项目文档
include 构建.py 构建配置.json
prune Build/源码
prune Build/新构建
prune Build/输出
prune Build/环境
prune Build/缓存
prune Build/中间
prune Build/临时
global-exclude __pycache__ *.py[cod] .DS_Store

# Original logical paths exist only in the staged compatibility view.
include DEFENSIVE_SCOPE.md LICENSE ORIGIN.md README.md VALIDATION.md
